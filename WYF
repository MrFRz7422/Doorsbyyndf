-- Lighting
local function applyLighting()
	if Toggles.Fullbright.Value then
		Lighting.Brightness = 2
		Lighting.ClockTime = 14
		Lighting.FogEnd = 100000
		Lighting.GlobalShadows = false
		Lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 128)
	else
		Lighting.Brightness = State.OriginalBrightness
		Lighting.FogEnd = State.OriginalFog
		Lighting.GlobalShadows = true
	end
	if Toggles.NoFog.Value or Toggles.RemoveDarkness.Value then
		Lighting.FogEnd = 100000
		Lighting.FogStart = 0
		pcall(function()
			for _, v in ipairs(Lighting:GetChildren()) do
				if v:IsA("Atmosphere") or v:IsA("BloomEffect") or v:IsA("ColorCorrectionEffect") then
					if Toggles.RemoveDarkness.Value then v.Enabled = false end
				end
			end
		end)
	end
end
Toggles.Fullbright:OnChanged(applyLighting)
Toggles.NoFog:OnChanged(applyLighting)
Toggles.RemoveDarkness:OnChanged(applyLighting)

