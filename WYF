end

local function makeBillboard(adornee, text, color)
	local bb = Instance.new("BillboardGui")
	bb.Adornee = adornee
	bb.Size = UDim2.new(0, 140, 0, 28)
	bb.StudsOffset = Vector3.new(0, 2.8, 0)
	bb.AlwaysOnTop = true
	bb.Parent = ESPFolder
	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(1, 0, 1, 0)
	lbl.BackgroundTransparency = 0.3
	lbl.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	lbl.Text = text
	lbl.TextColor3 = color
	lbl.Font = Enum.Font.GothamBold
	lbl.TextSize = 12
	lbl.Parent = bb
	Instance.new("UICorner", lbl).CornerRadius = UDim.new(0, 4)
end

function refreshLists()
	State.DoorList = {}
	State.PlayerList = {}
	for _, obj in ipairs(workspace:GetDescendants()) do
		local n = string.lower(obj.Name)
		if (string.find(n, "door") or string.find(n, "gate") or string.find(n, "entrance"))
			and (obj:IsA("BasePart") or obj:IsA("Model") or obj:IsA("Folder")) then
			table.insert(State.DoorList, obj)
		end
	end
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LP then table.insert(State.PlayerList, plr) end
	end
	Library:Notify(string.format("Doors: %d | Players: %d", #State.DoorList, #State.PlayerList), 3)
end

-- ESP
RunService.RenderStepped:Connect(function()
	clearESP()
	if Toggles.PlayerESP.Value then
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LP and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
				makeBillboard(plr.Character.HumanoidRootPart, plr.Name, Color3.fromRGB(100, 180, 255))
			end
		end
	end
	if Toggles.DoorESP.Value then
		for _, d in ipairs(State.DoorList) do
			local part = d:IsA("BasePart") and d or d:FindFirstChildWhichIsA("BasePart", true)
			if part then makeBillboard(part, d.Name, Color3.fromRGB(100, 255, 140)) end
		end
	end
	if Toggles.EntityESP.Value then
		for _, ent in ipairs(State.EntityList) do
			if ent and ent.Parent then
				local part = ent:IsA("BasePart") and ent or ent:FindFirstChildWhichIsA("BasePart", true)
				if part then makeBillboard(part, ent.Name, Color3.fromRGB(255, 80, 80)) end
			end
		end
	end
end)

